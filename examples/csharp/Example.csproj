<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x86</PlatformTarget>
    <RuntimeIdentifier>win-$(PlatformTarget)</RuntimeIdentifier>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../bindings/YizPrintPdf.cs" Link="YizPrintPdf.cs" />
    <None Include="../../yiz-print-pdf.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../yiz-print-pdf.dll')" />
    <None Include="../../dist/win-$(PlatformTarget)/yiz-print-pdf.dll" Link="yiz-print-pdf.dll" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('../../yiz-print-pdf.dll')" />
  </ItemGroup>
</Project>
